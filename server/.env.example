PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
CLIENT_ORIGIN=http://localhost:5173

# One-click pupil sign-in on the login screen, so a rotating code is not needed
# while developing. Automatically off when NODE_ENV=production; set to 0 to
# disable it in development too.
DEV_PUPIL_LOGIN=1

# Where invitation links point. Set this to the address families and staff use
# in a browser: the API's own host is right in production, but in development
# the app is served by Vite on another port.
PUBLIC_URL=http://localhost:5173

# Attempts per IP against an invitation link, per 15 minutes. Successful opens
# are not counted, so this only limits replays of dead links.
RATE_LIMIT_INVITE=30
